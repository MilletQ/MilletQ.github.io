<header class="site-header">
  <div class="header-inner">
    <a class="brand" href="<%- url_for('/') %>" aria-label="<%= config.title %> 首页">
      <span class="brand-mark" aria-hidden="true">
        <svg viewBox="0 0 36 36" role="img">
          <path d="M7 7h22v22H7z"/>
          <path d="M12 12h5v12h-5zm8 0h4v5h-4zm0 8h4v4h-4z"/>
        </svg>
      </span>
      <span>
        <strong><%= config.title %></strong>
        <small>BIM DEV NOTES</small>
      </span>
    </a>

    <button class="nav-toggle" type="button" aria-label="打开导航" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>

    <nav class="site-nav" aria-label="主导航">
      <% for (const name in theme.menu) { %>
        <a href="<%- url_for(theme.menu[name]) %>"><%= name %></a>
      <% } %>
      <% if (theme.github) { %>
        <a class="github-link" href="<%= theme.github %>" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .7a11.5 11.5 0 0 0-3.64 22.4c.58.1.79-.25.79-.56v-2.23c-3.22.7-3.9-1.37-3.9-1.37-.52-1.34-1.28-1.7-1.28-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.57-.29-5.27-1.29-5.27-5.69 0-1.26.45-2.29 1.18-3.09-.12-.29-.51-1.46.11-3.04 0 0 .97-.31 3.17 1.18a10.9 10.9 0 0 1 5.78 0c2.2-1.49 3.17-1.18 3.17-1.18.62 1.58.23 2.75.11 3.04.74.8 1.18 1.83 1.18 3.09 0 4.42-2.7 5.39-5.28 5.68.42.36.79 1.06.79 2.14v3.18c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .7Z"/></svg>
          GitHub
        </a>
      <% } %>
    </nav>
  </div>
</header>
