<div class="article-shell">
  <article class="article">
    <header class="article-heading">
      <a class="back-link" href="<%- url_for('/') %>">← 返回教程列表</a>
      <div class="article-meta">
        <% if (page.tags && page.tags.length) { %>
          <% page.tags.each(function(tag) { %>
            <a class="post-tag" href="<%- url_for(tag.path) %>"><%= tag.name %></a>
          <% }) %>
        <% } %>
        <time datetime="<%= date_xml(page.date) %>"><%= date(page.date, 'YYYY年MM月DD日') %></time>
      </div>
      <h1><%= page.title %></h1>
      <p class="article-lead">一篇关于 <%= page.tags && page.tags.length ? page.tags.first().name : '开发实践' %> 的技术笔记。</p>
    </header>

    <div class="article-content">
      <%- page.content %>
    </div>

    <footer class="article-end">
      <span>END</span>
      <p>感谢阅读，希望这篇记录对你有所帮助。</p>
    </footer>

    <% if (page.prev || page.next) { %>
      <nav class="post-nav" aria-label="相邻文章">
        <% if (page.prev) { %>
          <a href="<%- url_for(page.prev.path) %>"><small>上一篇</small><strong><%= page.prev.title %></strong></a>
        <% } else { %><span></span><% } %>
        <% if (page.next) { %>
          <a class="next" href="<%- url_for(page.next.path) %>"><small>下一篇</small><strong><%= page.next.title %></strong></a>
        <% } %>
      </nav>
    <% } %>
  </article>

  <% const articleToc = toc(page.content, { list_number: false }); %>
  <% if (articleToc) { %>
    <aside class="article-aside">
      <div class="toc">
        <p>本页目录</p>
        <%- articleToc %>
      </div>
    </aside>
  <% } %>
</div>
